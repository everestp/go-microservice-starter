APP_ENV=local
SERVICE_NAME=gateway
LOG_LEVEL=INFO
GRPC_ADDR=:9090
HTTP_ADDR=:8080
DATABASE_URL=postgres://starter:starter@localhost:5432/gateway
NATS_URL=nats://localhost:4222
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
JWT_PRIVATE_KEY_FILE=./keys/auth_private.pem
JWT_KEY_ID=default
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2
AUTH_GRPC_ADDR=auth-service:9090
NOTES_GRPC_ADDR=notes-service:9090
AUDIT_GRPC_ADDR=audit-service:9090
JWKS_URL=http://auth-service:8081/.well-known/jwks.json
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_RPS=60
TRUSTED_PROXIES=10.0.0.0/8,127.0.0.1
